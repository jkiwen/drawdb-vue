{
  "name": "@drawdb/core",
  "version": "0.1.0",
  "description": "Core data models, state logic, and import/export utilities for drawDB Vue SDK",
  "license": "MIT",
  "author": "drawDB contributors",
  "keywords": [
    "drawdb",
    "database",
    "erd",
    "sql",
    "dbml"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/drawdb-io/drawdb.git",
    "directory": "sdk-workspace"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types ../../scripts/run-tests.mjs packages/core"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "fake-indexeddb": "^6.2.6",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@dbml/core": "3.13.9",
    "node-sql-parser": "5.4.0",
    "oracle-sql-parser": "0.1.0",
    "uuid": "^10.0.0"
  }
}
