{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rewriteRelativeImportExtensions": true,
    "noEmitOnError": true,
    "paths": {
      "@drawdb/core": ["../core/dist/index.d.ts"],
      "oracle-sql-parser": ["../core/src/types/oracle-sql-parser.d.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
