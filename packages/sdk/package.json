{
  "name": "@drawdb/vue-sdk",
  "version": "0.1.0",
  "description": "Vue 3 SDK components and composables for drawDB",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@drawdb/core": "workspace:*",
    "@vue/devtools-api": "^6.5.0",
    "naive-ui": "2.38.0",
    "pinia": "^2.2.0",
    "vue-demi": "^0.14.10"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/compiler-sfc": "3.5.0",
    "@vue/server-renderer": "3.5.0",
    "estree-walker": "2.0.2",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.1.0"
  }
}
