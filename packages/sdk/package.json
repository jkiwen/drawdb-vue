{
  "name": "@drawdb/vue-sdk",
  "version": "0.1.0",
  "description": "Vue 3 SDK components and composables for drawDB",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vue-tsc -p tsconfig.build.json --noCheck && node ../../scripts/build-sdk.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "pinia": "^2.2.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@drawdb/core": "workspace:*",
    "@intlify/core-base": "11.4.16",
    "@intlify/message-compiler": "11.4.16",
    "@intlify/shared": "11.4.16",
    "@vue/devtools-api": "^6.5.0",
    "naive-ui": "2.38.0",
    "pinia": "^2.2.0",
    "vue-demi": "^0.14.10",
    "vue-i18n": "^11.4.16"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/compiler-sfc": "3.5.0",
    "@vue/server-renderer": "3.5.0",
    "@vue/test-utils": "^2.5.1",
    "estree-walker": "2.0.2",
    "jsdom": "^30.1.3",
    "lru-cache": "11.5.3",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.1.0"
  }
}
