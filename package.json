{
  "name": "drawdb-vue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "description": "Vue 3 + TypeScript SDK for drawDB",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:packages": "pnpm --filter @drawdb/core run build && pnpm --filter @drawdb/vue-sdk run build",
    "test": "node --experimental-strip-types scripts/run-tests.mjs",
    "test:all": "pnpm run build:packages && pnpm run test",
    "typecheck": "tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p packages/sdk/tsconfig.json && tsc --noEmit -p packages/app/tsconfig.json && vue-tsc --noEmit -p examples/vue-embed/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:install": "playwright install --with-deps chromium",
    "plan:status": "node scripts/plan-status.mjs",
    "pack:packages": "pnpm --filter @drawdb/core pack --pack-destination .release && pnpm --filter @drawdb/vue-sdk pack --pack-destination .release"
  },
  "devDependencies": {
    "@playwright/test": "1.49.0",
    "@types/node": "^22.0.0",
    "@vitest/utils": "^2.1.0",
    "jsdom": "^30.1.3",
    "lru-cache": "11.5.3",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
