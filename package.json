{
  "name": "drawdb-vue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "description": "Vue 3 + TypeScript SDK for drawDB",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "test:workspace": "vitest run scripts/verify-workspace.test.ts",
    "test:node": "node --experimental-strip-types scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p packages/sdk/tsconfig.json && tsc --noEmit -p packages/app/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/utils": "^2.1.0",
    "jsdom": "^30.1.3",
    "lru-cache": "11.5.3",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
